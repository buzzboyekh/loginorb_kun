{
  "name": "lockin-orb",
  "productName": "Lock-in Orb",
  "version": "1.0.0",
  "description": "桌面常駐的 lock-in 解壓小球：Siri 球式流動，色票取自《光與壑》",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test-haptic": "node scripts/test-haptic.js",
    "pack": "electron-packager . \"Lock-in Orb\" --platform=darwin --arch=arm64 --out=dist --overwrite --ignore=\"^/dist\"",
    "pack:intel": "electron-packager . \"Lock-in Orb\" --platform=darwin --arch=x64 --out=dist --overwrite --ignore=\"^/dist\""
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.0.0"
  }
}
